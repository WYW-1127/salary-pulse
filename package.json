{
  "name": "salary-pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:salary": "vite build --base=/salary/",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.cjs",
    "electron:dev": "node scripts/electron-dev.cjs",
    "smoke": "npm run build && electron scripts/smoke.cjs",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "com.wyw.salary-pulse",
    "productName": "薪资跳动",
    "files": ["dist/**", "electron/**", "assets/**", "package.json"],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "shortcutName": "薪资跳动"
    }
  }
}
